{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CocoaDesk",
  "version": "0.1.0",
  "identifier": "com.cocoasuite.cocoadesk",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5190",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CocoaDesk",
        "width": 1360,
        "height": 880,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#121212",
        "center": true,
        "maximized": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "CocoaSuite",
    "copyright": "Copyright © CocoaSuite",
    "category": "Productivity",
    "shortDescription": "Your personal desk",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}